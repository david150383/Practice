f.parent to child todo list

import React, { useState } from "react";
import Child from "./child";

function App() {
  const [todos, setTodos] = useState([]);
  const handleAdd = (content: string) => {
    let currentTodos = [...todos];
    currentTodos.push({ id: Date.now(), content, completed: false });
    setTodos(currentTodos);
  };
  const markComplete = (todo) => {
    const updatedList = todos.map((item) => {
      if (item.id === todo.id) {
        item.completed = true;
      }
      return item;
    });
    setTodos(updatedList);
  };
  const listStyle = {
    display: "grid",
    gridTemplateColumns: "1fr auto",
    gap: "1em",
    border: "1px solid grey",
    backgroundColor: "green",
  };
  const activeClass = {};
  return (
    <>
      <h1>Todos</h1>
      <ul>
        {todos.map((todo) => (
          <li style={todo.completed ? listStyle : {}} key={todo.id}>
            <div>
              {todo.content}: {todo.completed}
            </div>
            <div>
              <button
                onClick={() => {
                  markComplete(todo);
                }}
              >
                Completed
              </button>
            </div>
          </li>
        ))}
      </ul>
      <Child addTodo={handleAdd} />
    </>
  );
}
export default App;


