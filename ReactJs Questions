        onKeyDown={handleKeyDown}
        onChange={(e) => setTask(e.target.value)}
        placeholder="Add a to-do and press Enter"
      />
    </>
  );
}
export default Child;


g: Phonebook

import React, { useState } from "react";

function App() {
  const [contacts, setContacts] = useState([
    { firstName: "John", lastName: "Smith", phone: "1234567890" },
    { firstName: "Alice", lastName: "Brown", phone: "9876543210" },
    { firstName: "David", lastName: "Wilson", phone: "5556667777" },
  ]);

  const [form, setForm] = useState({
    firstName: "",
    lastName: "",
    phone: "",
  });

  const handleChange = (e) => {
    setForm({
      ...form,
      [e.target.name]: e.target.value,
    });
  };

  const addContact = (e) => {
    e.preventDefault();

    const updatedContacts = [...contacts, form];

    // sort by last name
    updatedContacts.sort((a, b) => a.lastName.localeCompare(b.lastName));

    setContacts(updatedContacts);

    setForm({
      firstName: "",
      lastName: "",
      phone: "",
    });
  };

  return (
    <div style={{ padding: "20px", fontFamily: "Arial" }}>
      <h2>Phonebook</h2>

      <form onSubmit={addContact}>
        <input
          name="firstName"
          placeholder="First Name"
          value={form.firstName}
          onChange={handleChange}
          required
        />

        <input
          name="lastName"
          placeholder="Last Name"
          value={form.lastName}
          onChange={handleChange}
          required
        />

        <input
          name="phone"
          placeholder="Phone"
          value={form.phone}
          onChange={handleChange}
          required
        />

        <button type="submit">Add</button>
      </form>

      <h3>Contacts</h3>

      <ul>
        {contacts.map((c, index) => (
          <li key={index}>
            {c.firstName} {c.lastName} - {c.phone}
          </li>
        ))}
      </ul>
    </div>
  );
}

export default App;
