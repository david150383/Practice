a) Counter Component

import React, { useState } from "react";

function App() {
  const [count, setCount] = useState(2);
  const buttonStyle = {
    color: "blue",
    backgroundColor: "lightblue", // Note camelCase
    padding: "10px",
    borderRadius: "5px",
  };
  return (
    <>
      <p>Initial count is : {count}</p>
      <button style={{
          color: "red",
        }} onClick={() => setCount(count + 1)}>+</button>
      <button style={buttonStyle}
        disabled={count === 0} onClick={() => setCount(count - 1)}>-</button>
    </>
  );
}
export default App;



b) Fetch API and display list
//The browser fetch() function itself returns a Promise that resolves to a Response object. It does not directly return a string or JSON. You must call a specific method on the Response object, such as response.json() or response.text(), to access the data in the desired format. 
import React, { useState, useEffect } from "react";
function App() {
  const [users, setUsers] = useState([]);
  useEffect(() => {
    fetch("https://jsonplaceholder.typicode.com/users")
      .then((res) => res.json())
      .then((res) => setUsers(res));
  }, []);
  return (
    <>
      <ul>
        {users.map((user) => (
          <li key={user.id}>{user.name}</li>
        ))}
      </ul>
    </>
  );
}
export default App;

fetch using async await

import React, { useEffect, useState } from "react";

function App() {
  const [users, setUsers] = useState([]);
  const [loading, setLoading] = useState(false);
  const fetchUsers = async () => {
    try {
      setLoading(true);
      const response = await fetch("https://jsonplaceholder.typicode.com/user");
      if (!response.ok) {
        throw new Error(`HTTP error! Status: ${response.status}`);
      }
      const data = await response.json();
      setUsers(data);
    } catch (err: unknown) {
      console.log("Error while fetching data", err.message);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchUsers();
  }, []);

  return (
    <>
      <h1>Users</h1>
      {loading && <p>Loading Users...</p>}
      {!loading && users.map((user) => <li className="px-2 py-0.5 bg-red-300 my-0.5" key={user.id}>{user.name}</li>)}
    </>
  );
}
export default App;


users list using axios

import React, { useState, useEffect } from "react";
import axios from "axios";
function App() {
  const [users, setUsers] = useState([]);
  const [loading, setLoading] = useState(false);
  const fetchUsers = async () => {
    setLoading(true);
    try {
      const response = await axios.get(
        "https://jsonplaceholder.typicode.com/users",
      );
      setUsers(response.data);
    } catch (err) {
      if (err instanceof Error) {
        throw new Error(`Failed to fetch data: ${err.message}`);
      }
      throw new Error("Failed to fetch data: Unknown error");
    } finally {
      setLoading(false);
    }
  };
  useEffect(() => {
    fetchUsers();
  }, []);
  return (
    <>
      <h1>Users</h1>
      {loading && <div>Loading Users....</div>}
      {!loading && (
        <ul>
          {users.map((user) => (
            <li key={user.id}>{user.name}</li>
          ))}
        </ul>
      )}
    </>
  );
}
export default App;

