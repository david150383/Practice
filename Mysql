26. Find Second Highest Salary Using Rank
SELECT *
FROM (
    SELECT name, salary,
    RANK() OVER (ORDER BY salary DESC) AS rnk
    FROM employees
) t
WHERE rnk = 2;

---
END OF DOCUMENT


Rank
RANK() 1,2,2,4, Skips numbers after ties, Same salaries get the same rank
DENSE_RANK() 1,2,2,3.  No gaps in ranking
ROW_NUMBER() 1,2,3,4. Always gives unique numbers, Ignores ties

SELECT * FROM (SELECT *, DENSE_RANK() OVER (ORDER BY salary DESC) AS rnk FROM employees) t
SELECT *, DENSE_RANK() OVER (ORDER BY salary DESC) AS rnk FROM employees;

both above queries are same but with second we can not filter using rnk, because rank is calculated after WHERE so Thats why filtering needs a subquery or CTE


WITH ranked AS (
    SELECT *, 
           DENSE_RANK() OVER (ORDER BY salary DESC) AS rnk
    FROM employees
)
SELECT *
FROM ranked
WHERE rnk <= 3;

SELECT * FROM (SELECT *, DENSE_RANK() OVER (ORDER BY salary DESC) AS rnk FROM employees) t WHERE rnk <= 3;

2. If You Want Only Top 2 Departments

SELECT *
FROM (
    SELECT 
        department,
        AVG(salary) AS avg_salary,
        DENSE_RANK() OVER (ORDER BY AVG(salary) DESC) AS rnk
    FROM employees
    GROUP BY department
) t
WHERE rnk <= 2;
