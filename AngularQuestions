//1 Counter Component
import { Component } from '@angular/core';

@Component({
  selector: 'app-counter',
  standalone: true,
  template: `<h2>Counter New: {{ count }}</h2>

    <button (click)="decrement()" [disabled]="count === 0">-</button>
    <button (click)="increment()">+</button>`,
})
export class CounterComponent {
  count = 0;

  increment() {
    this.count++;
  }

  decrement() {
    if (this.count > 0) {
      this.count--;
    }
  }
}


